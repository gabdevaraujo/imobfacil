{
  "info": {
    "name": "Imobfácil API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"senha\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Corretores",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/corretores?page=0&size=10&sort=nome,asc",
              "host": ["{{base_url}}"],
              "path": ["corretores"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "nome,asc" }
              ]
            }
          }
        },
        {
          "name": "Buscar por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/corretores/1",
              "host": ["{{base_url}}"],
              "path": ["corretores", "1"]
            }
          }
        },
        {
          "name": "Buscar por email",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/corretores/email/corretor@imobfacil.com.br",
              "host": ["{{base_url}}"],
              "path": ["corretores", "email", "corretor@imobfacil.com.br"]
            }
          }
        },
        {
          "name": "Buscar por CRECI",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/corretores/creci/123456-F",
              "host": ["{{base_url}}"],
              "path": ["corretores", "creci", "123456-F"]
            }
          }
        },
        {
          "name": "Criar corretor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"creci\": \"123456-F\",\n  \"telefone\": \"(11) 99999-0001\",\n  \"email\": \"joao.silva@imobfacil.com.br\",\n  \"foto\": \"https://example.com/fotos/joao.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/corretores",
              "host": ["{{base_url}}"],
              "path": ["corretores"]
            }
          }
        },
        {
          "name": "Atualizar corretor",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva Atualizado\",\n  \"creci\": \"123456-F\",\n  \"telefone\": \"(11) 99999-0002\",\n  \"email\": \"joao.silva@imobfacil.com.br\",\n  \"foto\": \"https://example.com/fotos/joao-novo.jpg\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/corretores/1",
              "host": ["{{base_url}}"],
              "path": ["corretores", "1"]
            }
          }
        },
        {
          "name": "Deletar corretor",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/corretores/1",
              "host": ["{{base_url}}"],
              "path": ["corretores", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Características",
